# Copiar a .env y completar. .env NUNCA se versiona.

# --- Base de datos ---
POSTGRES_PASSWORD=cambia-esta-clave
DATABASE_URL=postgresql+psycopg://techstore:cambia-esta-clave@localhost:5434/techstore
TEST_DATABASE_URL=postgresql+psycopg://techstore:cambia-esta-clave@localhost:5434/techstore_test

# --- JWT ---
JWT_SECRET=genera-con-secrets-token-urlsafe-48-minimo-32-caracteres
JWT_EXPIRA_MINUTOS=30

# --- MFA ---
MFA_CLAVE_CIFRADO=genera-con-fernet-generate-key
MFA_EMISOR=TechStore

# --- Bloqueo de cuenta ---
LOGIN_MAX_INTENTOS=5
BLOQUEO_MINUTOS=15

# --- Desafio MFA ---
MFA_MAX_INTENTOS=3
DESAFIO_MINUTOS=5

# --- OAuth (opcional; ausente => 503 en ese proveedor) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- General ---
URL_PUBLICA=http://localhost:8080
COOKIE_SECURE=0
STOCK_BAJO_UMBRAL=5
